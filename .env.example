# ---- External bot database (server-only; required on Railway) ----
EXTERNAL_DB_URL=https://yyhkhqcqeppavpvdiflv.supabase.co
EXTERNAL_DB_SERVER_KEY=

# ---- Managed integration configuration (not used for bot data) ----
# Server-side values. On the Lovable Cloud backend the service key is not
# copyable; for self-hosting, point these at a database project you own.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- Browser-side values (baked in at build time) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- Lovable / Telegram connector gateway ----
# The bot talks to Telegram through the Lovable connector gateway, so these
# two values are required even on your own host. LOVABLE_API_KEY comes from
# your Lovable project settings; TELEGRAM_API_KEY is the connection key of
# the linked Telegram connection in Lovable.
LOVABLE_API_KEY=
TELEGRAM_API_KEY=

# ---- Verification bridge (shared with the Telethon helper) ----
# The same value must be set in the bridge helper's config.
VERIFIER_SECRET=
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_2FA_PASSWORD=
AFFILIATE_BOT=

# ---- Admin panel ----
ADMIN_PASSWORD=
SESSION_SECRET=
